{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and profile details.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Auth User ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's verified email address."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "The display name of the user."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "URL of user photo."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user document was created."
        }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "Task": {
      "title": "To-Do Task",
      "description": "A single task item in the user's to-do list.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The title of the task."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Detailed description of the task."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed"],
          "description": "The completion status of the task."
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "normal"],
          "description": "Priority tier of the task."
        },
        "categoryId": {
          "type": "string",
          "maxLength": 50,
          "description": "The category of the task (e.g., 'work', 'project', 'personal', 'learning')."
        },
        "dueDate": {
          "type": "string",
          "maxLength": 10,
          "description": "The due date in YYYY-MM-DD format."
        },
        "dueTime": {
          "type": "string",
          "maxLength": 5,
          "description": "The due time in HH:MM format."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the task was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the task was last updated."
        },
        "ownerId": {
          "type": "string",
          "description": "The user ID of the task owner."
        },
        "subtasks": {
          "type": "array",
          "description": "A list of subtask items (max 10)."
        }
      },
      "required": ["title", "status", "priority", "categoryId", "ownerId", "createdAt", "updatedAt"]
    },
    "UserSetting": {
      "title": "User Settings",
      "description": "Configuration preferences for a user, including DND and notifications.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The user ID."
        },
        "darkMode": {
          "type": "boolean",
          "description": "True if dark mode is enabled."
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Master switch to enable/disable notifications."
        },
        "dndEnabled": {
          "type": "boolean",
          "description": "Do Not Disturb schedule status."
        },
        "dndStartTime": {
          "type": "string",
          "maxLength": 5,
          "description": "DND start time (HH:MM)."
        },
        "dndEndTime": {
          "type": "string",
          "maxLength": 5,
          "description": "DND end time (HH:MM)."
        },
        "earlyReminderMinutes": {
          "type": "number",
          "description": "Default reminder advance time in minutes (15, 30, 60, etc.)."
        },
        "urgentReminderRepeat": {
          "type": "boolean",
          "description": "Repeat reminders before deadine."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when preferences were updated."
        }
      },
      "required": ["ownerId", "darkMode", "notificationsEnabled", "updatedAt"]
    },
    "Notification": {
      "title": "In-App Notification",
      "description": "An alert, reminder, or system activity for the user.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Header title of the notification."
        },
        "body": {
          "type": "string",
          "maxLength": 500,
          "description": "Text body explanation."
        },
        "type": {
          "type": "string",
          "enum": ["reminder", "system", "assignment"],
          "description": "Notification context type."
        },
        "read": {
          "type": "boolean",
          "description": "Read status."
        },
        "ownerId": {
          "type": "string",
          "description": "The targeted user ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["title", "body", "type", "read", "ownerId", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Stores basic user profiles."
    },
    "tasks/{taskId}": {
      "schema": "Task",
      "description": "Stores user to-do tasks with priority and due date."
    },
    "user_settings/{settingId}": {
      "schema": "UserSetting",
      "description": "Stores user DND, dark mode, and reminder settings. Document ID is the userId."
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Stores notifications and alert logs."
    }
  }
}
